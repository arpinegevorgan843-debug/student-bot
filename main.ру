# Функция для определения четности недели
def get_week_type(date_obj):
    week_number = date_obj.isocalendar()[1]
    return "Четная" if week_number % 2== 0 else "Нечетная"

class BotStates(StatesGroup):
    waiting_for_hw_text = State()
    waiting_for_hw_photo = State()
    waiting_for_note = State()
    waiting_for_subj_name = State()
    waiting_for_type = State()
    waiting_for_week = State()
    waiting_for_time = State()
    waiting_for_room = State()
    waiting_for_teacher = State()

