                await message.answer(T(lang, "no_lessons"))
                return
            
            res = T(lang, "day_head_date", day=today, date=date_str) + "\n\n"
            for lid, t, s, lt, r, te in lessons:
                emoji = subject_emoji(s)
                res += f"{emoji} <b>{t}</b> — {s}\n"
                res += f"   🏫 Кабинет: {r}\n"
                if te:
                    res += f"   👩‍🏫 Учитель: {te}\n"
                res += "\n"
            await message.answer(res, parse_mode="HTML")
            
        elif action == "tomorrow":
            tomorrow_idx = (datetime.now().weekday() + 1) % 7
            tomorrow = DAY_NAMES[lang][tomorrow_idx]
            # Для простоты берем дату +1 день
            date_str = (datetime.now() + timedelta(days=1)).strftime("%d.%m")
            lessons = await get_lessons_for_day(user_id, tomorrow)
            
            if not lessons:
                await message.answer(T(lang, "no_lessons"))
                return
            
            res = T(lang, "day_head_date", day=tomorrow, date=date_str) + "\n\n"
            for lid, t, s, lt, r, te in lessons:
                emoji = subject_emoji(s)
                res += f"{emoji} <b>{t}</b> — {s}\n"
                res += f"   🏫 Кабинет: {r}\n"
                if te:
                    res += f"   👩‍🏫 Учитель: {te}\n"
                res += "\n"
            await message.answer(res, parse_mode="HTML")
            
        elif action == "week":
