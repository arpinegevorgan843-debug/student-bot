# ---------- TO-DO ----------
@dp.message(F.text == "🌟 Списочек дел")
async def todo_list(message: types.Message):
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT id, text, done FROM tasks WHERE user_id=? ORDER BY id", (message.from_user.id,)) as cur:
            rows = await cur.fetchall()
    text = ("✅ <b>Списочек дел:</b>\n\n" if rows else "Списочек пуст. Напиши одно маленькое дело ✨:")
    buttons = []
    for tid, t, done in rows:
        if done:
            text += f"<s>☑️ {esc(t)}</s>\n"
            buttons.append((f"↩️ Вернуть: {t[:15]}", f"todo_{tid}"))
        else:
            text += f"▫️ {esc(t)}\n"
            buttons.append((f"✅ Выполнить: {t[:15]}", f"todo_{tid}"))
        buttons.append((f"🗑 Удалить: {t[:15]}", f"tododel_{tid}"))
    b = InlineKeyboardBuilder()
    for label, data in buttons:
        b.button(text=label, callback_data=data)
    b.button(text="➕ Добавить дело", callback_data="todo_add")
    b.button(text="◀️ Назад в меню", callback_data="back_to_main")
    b.adjust(1)
    await message.answer(text, reply_markup=b.as_markup(), parse_mode="HTML")

@dp.callback_query(F.data.startswith("todo_"))
async def todo_toggle(callback: types.CallbackQuery):
    tid = int(callback.data.split("_")[1])
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT done FROM tasks WHERE id=?", (tid,)) as cur:
            row = await cur.fetchone()
        await db.execute("UPDATE tasks SET done=? WHERE id=?", (0 if row[0] else 1, tid))
        await db.commit()
    await callback.answer()
    await todo_list_msg_refresh(callback)

async def todo_list_msg_refresh(callback: types.CallbackQuery):
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT id, text, done FROM tasks WHERE user_id=? ORDER BY id", (callback.from_user.id,)) as cur:
            rows = await cur.fetchall()
    text = ("✅ <b>Списочек дел:</b>\n\n" if rows else "Списочек пуст 🎉")
    b = InlineKeyboardBuilder()
    for tid, t, done in rows:
        if done:
            text += f"<s>☑️ {esc(t)}</s>\n"
            b.button(text=f"↩️ Вернуть: {t[:15]}", callback_data=f"todo_{tid}")
        else:
            text += f"▫️ {esc(t)}\n"
            b.button(text=f"✅ Выполнить: {t[:15]}", callback_data=f"todo_{tid}")
        b.button(text=f"🗑 Удалить: {t[:15]}", callback_data=f"tododel_{tid}")
    b.button(text="➕ Добавить дело", callback_data="todo_add")
    b.button(text="◀️ Назад в меню", callback_data="back_to_main")
    b.adjust(1)
    try:
        await callback.message.edit_text(text, reply_markup=b.as_markup(), parse_mode="HTML")
    except Exception:
        pass

