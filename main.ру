async def get_subjects(user_id):
    async with aiosqlite.connect(DB) as db:
        async with db.execute("""SELECT subject, day, time FROM schedule
            WHERE user_id=? AND (hidden IS NULL OR hidden=0)""", (user_id,)) as cur:
            rows = await cur.fetchall()
    seen = []
    for subj, day, time_ in sorted(rows, key=lambda r: (DAY_NAMES["ru"].index(r[1]), time_sort_key(r[2]))):
        if subj not in seen:
            seen.append(subj)
    return seen

async def get_subject_week_lessons(user_id, subject, monday):
    out = []
    async with aiosqlite.connect(DB) as db:
        for i in range(7):
            d = monday + timedelta(days=i)
            day_ru = DAY_NAMES["ru"][i]
            async with db.execute("""SELECT time, lesson_type, room FROM schedule
                WHERE user_id=? AND day=? AND subject=? AND (hidden IS NULL OR hidden=0)
                AND (week_type=? OR week_type='Каждую')""",
                (user_id, day_ru, subject, get_week_type(d))) as cur:
                rows = await cur.fetchall()
            for time_, ltype, room in sorted(rows, key=lambda x: time_sort_key(x[0])):
                out.append((d, time_, ltype, room))
    return out

def grades_table(lang, subj, rows):
    emoji = subject_emoji(subj)
    head = f"{emoji} <b>{esc(subj)}</b>\n"
    if not rows:
        return head + ("\nОценочек пока нет ✨" if lang == "ru" else "\nNo grades yet ✨")
    d_w, day_w, g_w = 6, 4, 6
    reasons = [r[2] for r in rows if r[2]]
    r_w = max(max(len(x) for x in reasons), 4) if reasons else 4
    lines = ["Дата   День  Оценка  За что", "─" * (d_w + day_w + g_w + r_w + 4)]
    for due, grade, reason in rows:
        try:
            dd = datetime.fromisoformat(due)
            ds = dd.strftime("%d.%m")
            dys = DAYS_SHORT[lang][dd.weekday()]
        except Exception:
            ds, dys = "—", "—"
        rs = reason if reason else "—"
        lines.append(f"{ds:<{d_w}} {dys:<{day_w}} {grade:<{g_w}} {rs}")
    return head + "\n<pre>" + html.escape("\n".join(lines)) + "</pre>"

