@dp.callback_query(F.data == "add_finance")
async def add_finance_start(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.edit_text("Напиши сумму и описание (например: 'кофе 250' или '+1500 репетитор'):", reply_markup=get_back_btn())
    await state.set_state(BotStates.waiting_for_finance)
    await callback.answer()

@dp.message(BotStates.waiting_for_finance)
async def add_finance_save(message: types.Message, state: FSMContext):
    text = message.text.lower()
    is_income = "+" in text
    amount = ''.join(filter(str.isdigit, text))
    
    if not amount:
        await message.answer("Не понял сумму. Напиши, например: 'кофе 250'")
        return
        
    async with aiosqlite.connect("db.sqlite") as db:
        await db.execute("INSERT INTO finance (user_id, type, amount, note) VALUES (?, ?, ?, ?)", 
                         (message.from_user.id, 'income' if is_income else 'expense', float(amount), text))
        await db.commit()
    await state.clear()
    await message.answer("✅ Записано в бюджет!", reply_markup=get_finance_menu())

@dp.callback_query(F.data == "stats_finance")
async def stats_finance(callback: types.CallbackQuery):
    async with aiosqlite.connect("db.sqlite") as db: 
    async with db.execute("SELECT type, SUM(amount) FROM finance WHERE user_id = ? GROUP BY type", (callback.from_user.id,)) as cursor:
            rows = await cursor.fetchall()
            
    income = 0
    expense = 0
    for r in rows:
        if r[0] == 'income': income = r[1]
        if r[0] == 'expense': expense = r[1]
        
    text = f"📊 **Твой бюджет:**\n\n🟢 Доходы: {income} руб.\n🔴 Расходы: {expense} руб.\n\n💰 Баланс: {income - expense} руб."
    await callback.message.edit_text(text, reply_markup=get_finance_menu(), parse_mode="Markdown")
    await callback.answer()

