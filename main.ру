                    text += ("📅 <b>Без даты</b>\n" if lang == "ru" else "📅 <b>No date</b>\n")
                last_due = due
            mark = "🔳" if done else "🔲"
            if done:
                text += f"  {mark} {subject_emoji(subj)} <b>{esc(subj)}</b>\n     <s>{esc(task)}</s>\n"
            else:
                text += f"  {mark} {subject_emoji(subj)} <b>{esc(subj)}</b>\n     {esc(task)}\n"
            b.button(text=(T(lang, "btn_undo", s=subj[:12]) if done else T(lang, "btn_done", s=subj[:12])),
                     callback_data=f"hwdone_{hw_id}")
            b.button(text=T(lang, "hw_menu_edit", s=subj[:12]), callback_data=f"hwedit_{hw_id}")
            if photo:
