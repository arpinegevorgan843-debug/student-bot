async def save_hw(user_id: int, hw_text: str, photos: list):
    words = []
    for w in hw_text.split():
        w = w.strip(string.punctuation).lower()
        if len(w) > 4:
            words.append(w[:5])

    nearest = None
    today = datetime.now()
    async with aiosqlite.connect(DB) as db:
        for i in range(8):
            d = today + timedelta(days=i)
            day_name = DAY_NAMES["ru"][d.weekday()]
            for w in words:
                async with db.execute("""SELECT subject, lesson_type FROM schedule
                    WHERE user_id=? AND day=? AND lower(subject) LIKE ?""",
                    (user_id, day_name, f"%{w}%")) as cur:
                    rows = await cur.fetchall()
                for r in rows:
                    lt = (r[1] or "").lower()
                    if "семинар" in lt or "seminar" in lt:
                        nearest = r[0]
                        break
                if nearest:
                    break
            if nearest:
                break
        if not nearest:
            return None
        cur = await db.execute("INSERT INTO homework (user_id, subject, task, photo_id) VALUES (?, ?, ?, ?)",
            (user_id, nearest, hw_text, ",".join(photos) if photos else None))
        await db.commit()
        return cur.lastrowid

