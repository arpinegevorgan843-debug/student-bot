async def build_week_view(user_id, offset, lang):
    monday = datetime.now() - timedelta(days=datetime.now().weekday()) + timedelta(weeks=offset)
    week_type = get_week_type(monday)
    text = T(lang, "week_head", week=wd(week_type, lang)) + "\n\n"
    empty = True
    async with aiosqlite.connect(DB) as db:
        for i in range(7):
            d = monday + timedelta(days=i)
            day_ru = DAY_NAMES["ru"][i]
            async with db.execute("""SELECT time, subject, lesson_type, room FROM schedule
                WHERE user_id=? AND day=? AND (week_type=? OR week_type='Каждую')""",
                (user_id, day_ru, get_week_type(d))) as cur:
                lessons = await cur.fetchall()
            lessons = sorted(lessons, key=lambda l: time_sort_key(l[0]))
            if lessons:
                empty = False
                text += f"📅 <b>{DAY_NAMES[lang][i]}:</b>\n"
                for num, l in enumerate(lessons, 1):
                    emoji = subject_emoji(l[1])
                    text += f"   {num}. {esc(l[0])} — {emoji} {esc(l[1])} ({esc(l[2])})"
                    if l[3]:
                        text += f", ауд. {esc(l[3])}"
                    text += "\n"
                text += "\n"
    if empty:
        text += T(lang, "week_empty")
    return text

async def send_week(callback: types.CallbackQuery, offset):
    lang = await get_lang(callback.from_user.id)
