    # Функция оставлена для совместимости, но теперь всегда "Каждую"
    t = (text or "").strip().lower()
    if t.startswith("чет") or t.startswith("even"):
        return "Каждую"
    if t.startswith("нечет") or t.startswith("нечёт") or t.startswith("odd"):
        return "Каждую"
    if t.startswith("каж") or t.startswith("every") or t.startswith("all"):
        return "Каждую"
    return "Каждую"

def esc(s):
    return html.escape(str(s or ""))

def time_sort_key(time_str):
    m = re.search(r"(\d{1,2}):(\d{2})", str(time_str or ""))
    if not m:
        return (23, 59)
    return (int(m.group(1)), int(m.group(2)))

