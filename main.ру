# ---------- КЭШ И СЖАТИЕ ФОТО ----------
async def download_and_cache_photo(url: str) -> str | None:
    """Скачивает фото, сжимает и сохраняет в кэш. Возвращает путь к файлу."""
    if not url:
        return None
    
    # Создаём безопасное имя файла из URL
    import hashlib
    file_hash = hashlib.md5(url.encode()).hexdigest()
    file_name = f"{file_hash}.jpg"
    file_path = os.path.join(PHOTO_CACHE_DIR, file_name)
    
    # Если фото уже в кэше — возвращаем путь
    if os.path.exists(file_path):
        return file_path
    
    # Скачиваем фото
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=10) as resp:
                if resp.status != 200:
                    return None
                data = await resp.read()
                
                # Сохраняем во временный файл
                temp_path = file_path + ".tmp"
                with open(temp_path, "wb") as f:
                    f.write(data)
                
                # Сжимаем фото через Pillow
                try:
                    with Image.open(temp_path) as img:
                        img = img.convert("RGB")
                        # Сжимаем до качества 85 и уменьшаем размер, если нужно
                        img.save(file_path, format="JPEG", quality=85, optimize=True)
                    os.remove(temp_path)
                    return file_path
                except Exception as e:
                    logging.error(f"Ошибка сжатия фото: {e}")
                    if os.path.exists(temp_path):
                        os.remove(temp_path)
                    return None
    except Exception as e:
        logging.error(f"Ошибка скачивания фото: {e}")
        return None

async def send_cached_photo(message: types.Message, file_path: str, caption: str = ""):
    """Отправляет фото из кэша как файл (чтобы не терялось качество и грузилось быстро)."""
    if not file_path or not os.path.exists(file_path):
        return
    
    try:
        with open(file_path, "rb") as photo:
            await message.answer_photo(
                photo=BufferedInputFile(photo.read(), filename="photo.jpg"),
                caption=caption,
                parse_mode="HTML"
            )
    except Exception as e:
        logging.error(f"Ошибка отправки фото: {e}")

