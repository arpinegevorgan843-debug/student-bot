    await state.update_data(gr_subject=subject)
    b = InlineKeyboardBuilder()
    for gid, due, grade, reason in rows:
        try:
            dd = datetime.fromisoformat(due)
            label = f"{dd.strftime('%d.%m')} · {grade} · {(reason or '—')[:20]}"
        except Exception:
            label = f"{grade} · {(reason or '—')[:20]}"
        b.button(text=label, callback_data=f"{'gedit' if action == 'edit' else 'gdel'}_{gid}")
    b.button(text=T(lang, "btn_back"), callback_data="gmenu_back")
    b.adjust(1)
    await callback.message.edit_text(
        (f"✏️ <b>{esc(subject)}</b> — выбери оценочку:" if lang == "ru"
         else f"✏️ <b>{esc(subject)}</b> — pick a grade:"),
