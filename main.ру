async def get_next_lesson_for_subject(user_id, subject_name):
    # Ищем ближайший будущий урок по предмету
    now = datetime.now()
    today_name = DAY_NAMES["ru"][now.weekday()]
    
    async with aiosqlite.connect(DB) as db:
        # Сначала ищем уроки сегодня
        async with db.execute("""
            SELECT time, subject, room, teacher FROM schedule 
            WHERE user_id = ? AND day = ? AND hidden = 0
            ORDER BY time
        """, (user_id, today_name)) as cur:
            today_lessons = await cur.fetchall()
        
        # Проверяем, есть ли уроки сегодня после текущего времени
        found_today = None
        for t, s, r, te in today_lessons:
            if s.lower().startswith(subject_name.lower()):
                # Парсим время начала
                start_time = datetime.strptime(t.split(" – "), "%H:%M")
                current_time = now.time()
                if start_time.hour > current_time.hour or (start_time.hour == current_time.hour and start_time.minute > current_time.minute):
                    return (t, s, r, te)
                # Если сегодня уже прошел, запоминаем как ближайший на сегодня (если нет завтра)
                if found_today is None:
                    found_today = (t, s, r, te)
        
        # Если не нашли сегодня, ищем на ближайшие дни
        days_order = DAY_NAMES["ru"]
        start_idx = days_order.index(today_name)
        
        for i in range(1, 7):
            next_day = days_order[(start_idx + i) % 7]
            async with db.execute("""
                SELECT time, subject, room, teacher FROM schedule 
                WHERE user_id = ? AND day = ? AND hidden = 0
                ORDER BY time
            """, (user_id, next_day)) as cur:
                lessons = await cur.fetchall()
                for t, s, r, te in lessons:
                    if s.lower().startswith(subject_name.lower()):
                        return (t, s, r, te)
        
        # Если ничего не нашли, возвращаем ближайший найденный сегодня (даже если прошел)
        return found_today

