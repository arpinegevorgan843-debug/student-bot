async def todo_list_render(chat_id, user_id, lang, message=None, callback=None):
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT id, text, done FROM tasks WHERE user_id=? ORDER BY id", (user_id,)) as cur:
            rows = await cur.fetchall()
    text = T(lang, "todo_head") + "\n\n" if rows else T(lang, "todo_empty")
    b = InlineKeyboardBuilder()
    for tid, t, done in rows:
        if done:
            text += f"<s>☑️ {esc(t)}</s>\n"
            b.button(text=T(lang, "btn_redo", s=t[:15]), callback_data=f"todo_{tid}")
        else:
            text += f"▫️ {esc(t)}\n"
            b.button(text=T(lang, "btn_todo", s=t[:15]), callback_data=f"todo_{tid}")
        b.button(text=T(lang, "btn_del", s=t[:15]), callback_data=f"tododel_{tid}")
