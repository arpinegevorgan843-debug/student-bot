async def save_hw_final(message: types.Message, state: FSMContext, photo_id):
    data = await state.get_data()
    hw_text = data['hw_text']
    subject_guess = hw_text.split()[0] if hw_text else "Общее"
    
    async with aiosqlite.connect("db.sqlite") as db:
        # Ищем семинар
        async with db.execute("SELECT subject, lesson_type FROM schedule WHERE user_id = ? AND subject LIKE ?", (message.from_user.id, f"%{subject_guess}%")) as cursor:
            lessons = await cursor.fetchall()
            
    seminar = next((l for l in lessons if "семинар" in l[1].lower()), None)
            
    if not seminar:
        await message.answer("❌ Семинар по этому предмету не найден. ДЗ не сохранено.", reply_markup=get_main_menu())
    else:
        exact_subject = seminar[0]
        async with aiosqlite.connect("db.sqlite") as db:
            await db.execute("INSERT INTO homework (user_id, subject, task, photo_id) VALUES (?, ?, ?, ?)", (message.from_user.id, exact_subject, hw_text, photo_id))
            await db.commit()
        await message.answer(f"✅ ДЗ добавлено к семинару *{exact_subject}*!", reply_markup=get_main_menu(), parse_mode="Markdown")
    await state.clear()

