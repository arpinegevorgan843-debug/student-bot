async def check_menu(message: types.Message, state: FSMContext):
    key = MENU_BY_TEXT.get(message.text or "")
    if key:
        await state.clear()
        if key == "start":
            await menu_start(message, state)
        elif key == "today":
            await sched_today_msg(message, state)
        elif key == "tomorrow":
            await sched_tomorrow_msg(message, state)
        elif key == "week":
            await sched_week_msg(message, state)
        elif key == "hw":
            await hw_menu_msg(message, state)
        elif key == "note":
            await note_start(message, state)
        elif key == "todo":
            await todo_list(message)
        elif key == "grades":
            await grades_menu(message, state)
        elif key == "setup":
            await setup_schedule(message)
        elif key == "edit":
            await edit_schedule(message)
        return True
    if (message.text or "").strip().lower() in ("отмена", "cancel"):
        lang = await get_lang(message.from_user.id)
        await state.clear()
        await message.answer(T(lang, "cancel"), reply_markup=main_menu_kb(lang))
        return True
    return False

