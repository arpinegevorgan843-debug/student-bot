    async with aiosqlite.connect(DB) as db:
        cur = await db.execute(
            "SELECT time_range, subject, lesson_type, room, teacher FROM schedule WHERE day=? AND week_type=?",
            (day_name, week_type)
        )
        rows = await cur.fetchall()
    
    if not rows:
        await message.answer(T("ru", "no_lessons"))
        return
    
    text = T("ru", "day_head_date", day=day_name, date=now.strftime("%d.%m"), week=wd(week_type, "ru"))
    text += "\n\n"
    
    for i, row in enumerate(rows, 1):
