# --- РАСПИСАНИЕ (ОБЩАЯ ФУНКЦИЯ) ---
async def show_schedule_for_day(callback: types.CallbackQuery, target_date: datetime):
    days_ru = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
    day_name = days_ru[target_date.weekday()]
    week_type = get_week_type(target_date)
    
    async with aiosqlite.connect("db.sqlite") as db:
        async with db.execute("SELECT id, time, subject, lesson_type, room, teacher, note FROM schedule WHERE user_id = ? AND day = ? AND (week_type = ? OR week_type = 'Каждую') ORDER BY time", (callback.from_user.id, day_name, week_type)) as cursor:
            lessons = await cursor.fetchall()
        async with db.execute("SELECT subject, task, photo_id FROM homework WHERE user_id = ? AND done = 0", (callback.from_user.id,)) as cursor:
            all_hws = await cursor.fetchall()
    
    header = f"📅 **{day_name} ({week_type} неделя)**\n\n"
    if not lessons:
        await callback.message.edit_text(header + "Пар нет! 🎉", reply_markup=get_back_btn(), parse_mode="Markdown")
        return

    text = header
    has_photos = False
    for l in lessons:
        lesson_id, time, subj, l_type, room, teacher, note = l
        text += f"⏰ {time} | 📖 {subj}\n"
        text += f"🎓 {l_type}"
        if room: text += f" | 🚪 {room}"
        if teacher: text += f" | 👨‍🏫 {teacher}"
        text += "\n"
        
        if "семинар" in l_type.lower():
            for hw in all_hws:
                hw_subj, hw_task, hw_photo = hw
                if hw_subj.lower() in subj.lower() or subj.lower() in hw_subj.lower():
                    text += f"   📝 ДЗ: {hw_task}\n"
                    if hw_photo:
                        text += f"   🖼 [Фото прикреплено]\n"
                        has_photos = True
        if note:
            text += f"   🗒 Заметка: {note}\n"
        text += "\n"
        
    builder = InlineKeyboardBuilder()
    for l in lessons:
        builder.button(text=f"🗒 Заметка к {l[2]}", callback_data=f"addnote_{l[0]}")
    if has_photos:
        builder.button(text="🖼 Посмотреть фото к ДЗ", callback_data="view_hw_photos")
    builder.button(text="◀️ Назад в меню", callback_data="back_to_main")
    builder.adjust(1)
    
    await callback.message.edit_text(text, reply_markup=builder.as_markup(), parse_mode="Markdown")

@dp.callback_query(F.data == "sched_today")
async def sched_today(callback: types.CallbackQuery):
    await show_schedule_for_day(callback, datetime.now())
    await callback.answer()

@dp.callback_query(F.data == "sched_tomorrow")
async def sched_tomorrow(callback: types.CallbackQuery):
    await show_schedule_for_day(callback, datetime.now() + timedelta(days=1))
    await callback.answer()

@dp.callback_query(F.data == "sched_week")
async def sched_week(callback: types.CallbackQuery):
    days_ru = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
    today = datetime.now()
    monday = today - timedelta(days=today.weekday())
    week_type = get_week_type(monday)
    
    text = f"🗓 **Расписание на неделю ({week_type})**\n\n"
    async with aiosqlite.connect("db.sqlite") as db:
        for i, day_name in enumerate(days_ru):
            async with db.execute("SELECT time, subject, lesson_type, room FROM schedule WHERE user_id = ? AND day = ? AND (week_type = ? OR week_type = 'Каждую') ORDER BY time", (callback.from_user.id, day_name, week_type)) as cursor:
                lessons = await cursor.fetchall()
            
            if lessons:
                text += f"**{day_name}:**\n"
                for l in lessons:
                    text += f"  {l[0]} - {l[1]} ({l[2]})"
                    if l[3]: text += f", ауд. {l[3]}"
                    text += "\n"
                text += "\n"
                
    if text == f"🗓 **Расписание на неделю ({week_type})**\n\n":
        text += "На эту неделю пар не задано."
        
    await callback.message.edit_text(text, reply_markup=get_back_btn(), parse_mode="Markdown")
    await callback.answer()

