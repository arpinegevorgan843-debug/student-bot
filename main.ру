# ---------- ТЕМАТИЧЕСКИЕ ЭМОДЗИ ПО ПРЕДМЕТАМ ----------
def subject_emoji(subj: str) -> str:
    s = (subj or "").lower()
    if any(x in s for x in ["конституц", "гос", "право"]):
        return "🏛️"
    if any(x in s for x in ["уголов", "кримин", "процесс"]):
        return "⚖️"
    if any(x in s for x in ["гражд", "хозяйств", "предпринимат"]):
        return "📜"
    if any(x in s for x in ["история", "ист", "древн"]):
        return "📂"
    return "📚"

