# --- ГЛАВНОЕ МЕНЮ ---
@dp.message(Command("start"))
async def cmd_start(message: types.Message, state: FSMContext):
    await state.clear()
    await message.answer( 
          f"Привет, {message.from_user.first_name}! 👋\nЯ твой умный студенческий ассистент.\nВыбери нужный раздел:",
        reply_markup=get_main_menu()
    )

@dp.callback_query(F.data == "back_to_main")
async def back_to_main(callback: types.CallbackQuery, state: FSMContext):
    await state.clear()
    await callback.message.edit_text("🏠 **Главное меню**\nВыбери нужный раздел:", reply_markup=get_main_menu(), parse_mode="Markdown")
    await callback.answer()

# --- ДОМАШНИЕ ЗАДАНИЯ ---
@dp.callback_query(F.data == "hw_menu")
async def hw_menu(callback: types.CallbackQuery):
    await callback.message.edit_text("📚 **Домашние задания**\nЧто будем делать?", reply_markup=get_hw_menu(), parse_mode="Markdown")
    await callback.answer()

@dp.callback_query(F.data == "add_hw")
async def add_hw_start(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.edit_text("Напиши предмет и задание (например: 'Математика задача 5'):", reply_markup=get_back_btn())
    await state.set_state(BotStates.waiting_for_hw)
    await callback.answer()

@dp.message(BotStates.waiting_for_hw)
async def add_hw_save(message: types.Message, state: FSMContext):
    async with aiosqlite.connect("db.sqlite") as db:
        await db.execute("INSERT INTO homework (user_id, task) VALUES (?, ?)", (message.from_user.id, message.text))
        await db.commit()
    await state.clear()
    await message.answer("✅ ДЗ добавлено в список!", reply_markup=get_hw_menu())

@dp.callback_query(F.data == "list_hw")
async def list_hw(callback: types.CallbackQuery):
    async with aiosqlite.connect("db.sqlite") as db:
        async with db.execute("SELECT id, task FROM homework WHERE user_id = ? AND done = 0", (callback.from_user.id,)) as cursor:
            rows = await cursor.fetchall()
    if not rows:
        await callback.message.edit_text("У тебя нет активных ДЗ! 🎉", reply_markup=get_hw_menu())
    else:
        builder = InlineKeyboardBuilder()
        text = "📋 **Твои ДЗ:**\n\n"
        for r in rows:
            text += f"• {r[1]}\n"
            builder.button(text=f"✅ Выполнено: {r[1][:15]}...", callback_data=f"done_hw_{r[0]}")
        builder.button(text="◀️ Назад", callback_data="hw_menu")
        builder.adjust(1)
        await callback.message.edit_text(text, reply_markup=builder.as_markup(), parse_mode="Markdown")
    await callback.answer()

@dp.callback_query(F.data.startswith("done_hw_"))
async def done_hw(callback: types.CallbackQuery):
    hw_id = callback.data.split("_")[2]
    async with aiosqlite.connect("db.sqlite") as db:
        await db.execute("UPDATE homework SET done = 1 WHERE id = ?", (hw_id,))
        await db.commit()
    await callback.answer("Выполнено! ✅")
    await list_hw(callback)

