@dp.message(BotStates.waiting_for_teacher)
async def proc_teacher(message: types.Message, state: FSMContext):
    data = await state.get_data()
    teacher = "" if message.text == "-" else message.text
    async with aiosqlite.connect(DB) as db:
        await db.execute("""INSERT INTO schedule (user_id, day, week_type, time, subject, lesson_type, room, teacher)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (message.from_user.id, data["day_name"], data["week_type"], data["time"], data["subject"], data["lesson_type"], data["room"], teacher))
        await db.commit()
    await state.clear()
    await message.answer(f"✅ Пара <b>{esc(data['subject'])}</b> добавлена ✨", reply_markup=main_menu_kb(), parse_mode="HTML")

