@dp.callback_query(F.data.startswith("eday_"))
async def edit_day(callback: types.CallbackQuery):
    day_index = int(callback.data.split("_")[1])
    day_name = DAYS[day_index]
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT id, time, subject, lesson_type FROM schedule WHERE user_id=? AND day=? ORDER BY time",
            (callback.from_user.id, day_name)) as cur:
            lessons = await cur.fetchall()
    b = InlineKeyboardBuilder()
    if not lessons:
        await callback.answer("В этот день пар нет ✨")
        return
    text = f"🔧 <b>{day_name}</b>. Нажми на пару, чтобы удалить:"
    for lid, t, subj, ltype in lessons:
        b.button(text=f"🗑 {t} {subj} ({ltype})", callback_data=f"delles_{lid}")
    b.button(text="➕ Добавить пару в этот день", callback_data=f"edadd_{day_index}")
    b.button(text="◀️ Назад в меню", callback_data="back_to_main")
    b.adjust(1)
    await callback.message.edit_text(text, reply_markup=b.as_markup(), parse_mode="HTML")
    await callback.answer()

