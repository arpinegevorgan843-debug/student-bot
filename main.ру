@dp.callback_query(F.data.startswith("hwdone_"))
async def hw_toggle(callback: types.CallbackQuery):
    hw_id = int(callback.data.split("_")[1])
    user_id = callback.from_user.id
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT done FROM homework WHERE id=?", (hw_id,)) as cur:
            row = await cur.fetchone()
        if not row:
            await callback.answer("Хм, эта домашечка уже не найдена 🙈")
            return
        old_done = row[0]
        new_done = 0 if old_done else 1

        await db.execute("UPDATE homework SET done=? WHERE id=?", (new_done, hw_id))

        # Счётчик достижений: только при переходе «не выполнено» → «выполнено»
        if new_done and not old_done:
            await db.execute("INSERT OR IGNORE INTO users_stats (user_id, total_done) VALUES (?, 0)", (user_id,))
            async with db.execute("SELECT total_done FROM users_stats WHERE user_id=?", (user_id,)) as cur:
                r = await cur.fetchone()
            total = (r[0] if r else 0) + 1
            await db.execute("UPDATE users_stats SET total_done=? WHERE user_id=?", (total, user_id))

            if total == 5:
                await callback.message.answer(
                    "🎉✨ Ого, ты закрыла уже 5 домашек! Это мини-достижение: «Железная дисциплина»! Ты просто супер, красотка! 🌸",
                    reply_markup=main_menu_kb()
                )
                try:
                    await callback.message.answer_photo(photo=random.choice(CUTE_IMAGES), caption="Для тебя, зайка 💕")
                except Exception:
                    pass

        await db.commit()

    if new_done:
        await callback.answer(random.choice(MOTIV_PHRASES))
    else:
        await callback.answer("Вернула в список — ничего страшного, успеешь позже 🌸")

    text, buttons = await build_day_view(user_id, datetime.now())
    try:
        await callback.message.edit_text(text, reply_markup=buttons_to_kb(buttons), parse_mode="HTML")
    except Exception:
        pass

