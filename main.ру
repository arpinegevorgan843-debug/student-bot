async def photo_reply_later(user_id: int, chat_id: int, lang: str):
    try:
        await asyncio.sleep(1.5)
        n = PHOTO_COUNTS.get(user_id, 0)
        await bot.send_message(chat_id, T(lang, "hw_photos", n=n))
    except asyncio.CancelledError:
        pass
    except Exception:
        pass
    finally:
        PHOTO_REPLY_TASKS.pop(user_id, None)

@dp.message(BotStates.waiting_for_hw_photo, F.photo)
async def add_hw_photo(message: types.Message, state: FSMContext):
    lang = await get_lang(message.from_user.id)
    data = await state.get_data()
    hw_id = data.get("hw_id")
    if hw_id is None:
        await state.clear()
        return
    photos = data.get("photos", []) + [message.photo[-1].file_id]
    await state.update_data(photos=photos)
    async with aiosqlite.connect(DB) as db:
        await db.execute("UPDATE homework SET photo_id=? WHERE id=?", (",".join(photos), hw_id))
        await db.commit()
    PHOTO_COUNTS[message.from_user.id] = len(photos)

    old = PHOTO_REPLY_TASKS.pop(message.from_user.id, None)
    if old:
        old.cancel()
    PHOTO_REPLY_TASKS[message.from_user.id] = asyncio.create_task(
        photo_reply_later(message.from_user.id, message.chat.id, lang)
    )

