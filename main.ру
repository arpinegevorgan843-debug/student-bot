async def build_week_view(user_id, offset, lang):
    monday = datetime.now() - timedelta(days=datetime.now().weekday()) + timedelta(weeks=offset)
    sunday = monday + timedelta(days=6)
    text = T(lang, "week_head") + "\n\n"
    empty = True
    async with aiosqlite.connect(DB) as db:
        # домашечки этой недели: {(due_date, subject): [(task, done), ...]}
        hw_by = {}
        async with db.execute("""SELECT subject, task, done, due_date FROM homework
            WHERE user_id=? AND due_date BETWEEN ? AND ?""",
            (user_id, monday.date().isoformat(), sunday.date().isoformat())) as cur:
            for subj, task, done, due in await cur.fetchall():
                hw_by.setdefault((due, subj), []).append((task, done))
        for i in range(7):
            d = monday + timedelta(days=i)
            day_ru = DAY_NAMES["ru"][i]
            date_str = f"{d.day} {MONTHS[lang][d.month - 1]}"
            async with db.execute("""SELECT time, subject, room, teacher FROM schedule
                WHERE user_id=? AND day=? AND (hidden IS NULL OR hidden=0)""",
                (user_id, day_ru)) as cur:
                lessons = await cur.fetchall()
            lessons = sorted(lessons, key=lambda l: time_sort_key(l[0]))
            if lessons:
                empty = False
                text += f"📅 <b>{DAY_NAMES[lang][i]}, {date_str}</b>\n\n"
                for num, l in enumerate(lessons, 1):
                    meta = esc(l[2]) if l[2] else ""
                    if l[3]:
                        meta += (f" · 👩‍🏫 {esc(l[3])}" if meta else f"👩‍🏫 {esc(l[3])}")
                    text += f"  {num}. ⏰ <b>{esc(l[0])}</b>\n"
                    text += f"     {subject_emoji(l[1])} <b>{esc(l[1])}</b>\n"
                    if meta:
                        text += f"     🏫 {meta}\n"
                    for hw_task, hw_done in hw_by.get((d.date().isoformat(), l[1]), []):
                        if hw_done:
                            text += f"     🔳 <s>{esc(hw_task)}</s>\n"
                        else:
                            text += f"     🔲 {esc(hw_task)}\n"
                    text += "\n"
    if empty:
        text += T(lang, "week_empty")
    return text

