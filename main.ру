async def build_day_view(user_id, target_date, lang):
    day_ru = DAY_NAMES["ru"][target_date.weekday()]
    week_type = get_week_type(target_date)
    date_str = f"{target_date.day} {MONTHS[lang][target_date.month - 1]}"
    async with aiosqlite.connect(DB) as db:
        async with db.execute("""SELECT id, time, subject, lesson_type, room, teacher, note FROM schedule
            WHERE user_id=? AND day=? AND (week_type=? OR week_type='Каждую') AND (hidden IS NULL OR hidden=0)""",
            (user_id, day_ru, week_type)) as cur:
            lessons = await cur.fetchall()
        async with db.execute("""SELECT id, subject, task, photo_id, done FROM homework
            WHERE user_id=? AND due_date=?""",
            (user_id, target_date.date().isoformat())) as cur:
            day_hws = await cur.fetchall()

    hw_map = {}
    for h in day_hws:
        hw_map.setdefault(h[1], h)
    lessons = sorted(lessons, key=lambda l: time_sort_key(l[1]))

    head = T(lang, "day_head_date", day=DAY_NAMES[lang][target_date.weekday()],
             week=wd(week_type, lang), date=date_str)

    if not lessons:
        return head + "\n\n" + T(lang, "no_lessons"), []

    text = head + "\n\n" + DIVIDER + "\n\n"
    buttons = []
    for num, (lesson_id, time_, subj, l_type, room, teacher, note) in enumerate(lessons, 1):
        extra = ""
        if subj in hw_map:
            hw_id, hw_subj, hw_task, hw_photo, hw_done = hw_map[subj]
            if hw_done:
                extra += f"\n     🔳 {esc(hw_task)}"
            else:
                extra += f"\n     🔲 {esc(hw_task)}"
                buttons.append((T(lang, "btn_done", s=subj[:15]), f"hwdone_{hw_id}"))
                if hw_photo:
                    buttons.append((T(lang, "btn_photo"), f"hwphoto_{hw_id}"))

        if note:
            extra += "\n     " + T(lang, "note_lbl", note=esc(note))

        text += lesson_block(num, time_, subj, l_type, room, teacher, extra) + "\n\n"
        buttons.append((T(lang, "btn_note", s=subj[:15]), f"addnote_{lesson_id}"))

    text += DIVIDER
    return text, buttons

