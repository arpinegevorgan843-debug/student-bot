async def build_week_view(user_id, offset):
    monday = datetime.now() - timedelta(days=datetime.now().weekday()) + timedelta(weeks=offset)
    week_type = get_week_type(monday)
    text = f"🗓 <b>Расписание на неделю ({week_type})</b>\n\n"
    empty = True
    async with aiosqlite.connect(DB) as db:
        for i, day_name in enumerate(DAYS):
            d = monday + timedelta(days=i)
            async with db.execute("""SELECT time, subject, lesson_type, room FROM schedule
                WHERE user_id=? AND day=? AND (week_type=? OR week_type='Каждую') ORDER BY time""",
                (user_id, day_name, get_week_type(d))) as cur:
                lessons = await cur.fetchall()
            if lessons:
                empty = False
                text += f"<b>{day_name}:</b>\n"
                for l in lessons:
                    emoji = subject_emoji(l[1])
                    text += f"  {esc(l[0])} - {emoji} {esc(l[1])} ({esc(l[2])})"
                    if l[3]: text += f", ауд. {esc(l[3])}"
                    text += "\n"
                text += "\n"
    if empty:
        text += "На этой недельке пока ни одной пары — просто красота 💕✨"
    return text

