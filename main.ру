# ---------- «МИЛЫЙ» РАЗГОВОР ----------
@dp.message()
async def chat_chat(message: types.Message):
    t = message.text or ""
    if t.startswith("/"):
        await message.answer("Хм, такой команды пока нет. Напиши /start ✨")
        return
    if "спасибо" in t.lower() or "спс" in t.lower():
        addr = random.choice(THANKS_ADDRS)
        await message.answer(f"Ой, спасибочки 💕✨… и тебе спасибо, {addr}. Рада всегда помочь 🌸")
        try:
            await message.answer_photo(photo=random.choice(CUTE_IMAGES), caption="Для тебя ✨")
        except Exception:
            pass
        return
    await message.answer(random.choice(FALLBACK_PHRASES))

# ---------- СЕРВЕР ----------
async def web_server():
    app = web.Application()
    app.router.add_get("/", lambda r: web.Response(text="Bot is running 💕"))
    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", 8080)
    await site.start()

async def main():
    await init_db()
    asyncio.create_task(web_server())
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
