def T(lang, key, **kw):
    s = S[lang][key]
    return s.format(**kw) if kw else s

def phrase(lang, group):
    return random.choice(PHR[group][lang])

def esc(s):
    return html.escape(str(s)) if s else ""

def subject_emoji(subj):
    subj_l = subj.lower()
    if "англ" in subj_l or "english" in subj_l: return "🇬🇧"
    if "филос" in subj_l: return "💭"
    if "истор" in subj_l: return "📜"
    if "прав" in subj_l: return "⚖️"
    if "докумен" in subj_l: return "📄"
    if "техн" in subj_l or "it" in subj_l: return "💻"
    if "физ" in subj_l: return "🏃‍♀️"
    if "этик" in subj_l: return "💖"
    return "📚"

