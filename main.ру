async def show_grade_week(callback: types.CallbackQuery, idx: int, offset: int, lang: str):
    user_id = callback.from_user.id
    subjects = await get_subjects(user_id)
    subject = subjects[idx]
    now = datetime.now()
    monday = now - timedelta(days=now.weekday()) + timedelta(weeks=offset)
    lessons = await get_subject_week_lessons(user_id, subject, monday)

    text = f"🎀 <b>{esc(subject)}</b> — {wd(get_week_type(monday), lang)} неделя\n"
    text += ("🕰 — пара уже прошла, оценочку тоже можно поставить ✨" if lang == "ru"
             else "🕰 — past lesson, you can still add a grade ✨")
    if not lessons:
        text += ("\n\nНа этой неделе у этой дисциплины пар нет 🙈" if lang == "ru"
                 else "\n\nNo lessons of this subject this week 🙈")

    b = InlineKeyboardBuilder()
    n = 0
    for d, time_, ltype, room in lessons:
        past = datetime(d.year, d.month, d.day) < datetime(now.year, now.month, now.day)
        label = f"{'🕰' if past else '📅'} {DAYS_SHORT[lang][d.weekday()]} {d.day}.{d.month:02d} · {time_}"
        b.button(text=label, callback_data=f"gles_{d.date().isoformat()}_{time_}")
        n += 1
    b.button(text="⬅️ Пред. неделя" if lang == "ru" else "⬅️ Prev", callback_data=f"gweek_{idx}_{offset-1}")
    b.button(text="След. неделя ➡️" if lang == "ru" else "Next ➡️", callback_data=f"gweek_{idx}_{offset+1}")
    b.button(text=T(lang, "btn_back"), callback_data="gmenu_back")
    b.adjust(*([1] * n), 2, 1)
    try:
        await callback.message.edit_text(text, reply_markup=b.as_markup(), parse_mode="HTML")
    except Exception:
        await callback.message.answer(text, reply_markup=b.as_markup(), parse_mode="HTML")
    await callback.answer()

