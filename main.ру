def lesson_block(num, time_, subj, ltype, room, teacher, hw_text="", hw_done=False):
    meta = esc(ltype)
    if room:
        meta += f" · 📍 {esc(room)}"
    if teacher:
        meta += f" · 🦋 {esc(teacher)}"
    
    block = (f"<b>{num}.</b> ⏰ <b>{esc(time_)}</b>\n"
             f"     {subject_emoji(subj)} <b>{esc(subj)}</b>\n"
             f"     🎓 {meta}")
    
    if hw_text:
        if hw_done:
            block += f"\n     {T('ru', 'hw_done_in_schedule', hw=esc(hw_text))}"
        else:
            block += f"\n     {T('ru', 'hw_in_schedule', hw=esc(hw_text))}"
            
    return block

async def safe_send(message, text, reply_markup=None):
    parts = [p for p in text.split("\n\n") if p]
    cur = ""
    first = True
    for p in parts:
        if len(cur) + len(p) + 2 <= 3800:
            cur = p if not cur else cur + "\n\n" + p
        else:
            await message.answer(cur, reply_markup=reply_markup if first else None, parse_mode="HTML")
            first = False
            cur = p
    if cur:
        await message.answer(cur, reply_markup=reply_markup if first else None, parse_mode="HTML")

