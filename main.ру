        await message.answer(T(lang, "unknown_cmd"))
        return
    if "спасибо" in t.lower() or "спс" in t.lower() or "thank" in t.lower() or "thx" in t.lower():
        addr = random.choice(PHR["thanks_addr"][lang])
        await message.answer(T(lang, "thanks", addr=addr))
        try:
            await message.answer_photo(photo=random.choice(CUTE_IMAGES), caption=T(lang, "photo_cap"))
        except Exception:
            pass
        return
    await message.answer(phrase(lang, "fallback"))

# ---------- РОЗОВАЯ ФОТО-КАРТОЧКА РАСПИСАНИЯ ----------
PINK_DARK = (128, 45, 82)
PINK_ACCENT = (232, 96, 152)
PINK_MUTED = (196, 120, 152)
CARD_FILL = (255, 250, 252)
CARD_LINE = (255, 178, 208)

def _font(size, bold=False):
    key = (size, bold)
    if key in _FONT_CACHE:
        return _FONT_CACHE[key]
    f = None
    try:
        from matplotlib import font_manager
        family = "DejaVu Sans Bold" if bold else "DejaVu Sans"
        f = ImageFont.truetype(font_manager.findfont(family), size)
    except Exception:
        pass
    if f is None:
        name = "DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"
        for path in ("/usr/share/fonts/truetype/dejavu/" + name,
                     "/usr/share/fonts/dejavu/" + name):
            try:
                f = ImageFont.truetype(path, size)
                break
            except Exception:
                pass
    if f is None:
        f = ImageFont.load_default()
    _FONT_CACHE[key] = f
    return f

def _pink_gradient(W, H):
    grad = Image.new("RGB", (1, 2))
    px = grad.load()
    px[0, 0] = (255, 240, 247)
    px[0, 1] = (255, 198, 223)
    return grad.resize((W, H))

def _wrap(d, text, font, max_w):
    lines, cur = [], ""
    for w in str(text).split():
        t = (cur + " " + w).strip()
        if cur and d.textlength(t, font=font) > max_w:
            lines.append(cur)
            cur = w
        else:
            cur = t
    if cur:
        lines.append(cur)
    return lines

def _heart(d, x, y, s, fill):
    d.ellipse([x - s, y - s, x, y], fill=fill)
    d.ellipse([x, y - s, x + s, y], fill=fill)
    d.polygon([(x - s, y - s // 3), (x + s, y - s // 3), (x, y + s)], fill=fill)

def _center_text(d, x, y, text, font, fill):
    try:
        d.text((x, y), text, font=font, fill=fill, anchor="mm")
    except Exception:
        l, t, r, b = d.textbbox((0, 0), text, font=font)
        d.text((x - (r - l) // 2, y - (b - t) // 2), text, font=font, fill=fill)

async def _fetch_cute_photo(user_id=None):
    # Свой фон — с кешем в памяти
    if user_id and user_id in BACKGROUNDS:
        if user_id in BG_CACHE:
            return BG_CACHE[user_id].copy()
        try:
            f = await bot.get_file(BACKGROUNDS[user_id])
            buf = io.BytesIO()
            await bot.download_file(f.file_path, buf)
            buf.seek(0)
            img = Image.open(buf).convert("RGB")
            BG_CACHE[user_id] = img
            return img.copy()
        except Exception:
            pass
    # Картинки из интернета — тоже кешируем, чтобы не качать каждый раз
    url = random.choice(CUTE_IMAGES)
    if url in URL_IMG_CACHE:
        return URL_IMG_CACHE[url].copy()
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=aiohttp.ClientTimeout(total=8)) as r:
                if r.status == 200:
                    img = Image.open(io.BytesIO(await r.read())).convert("RGB")
                    URL_IMG_CACHE[url] = img
                    return img.copy()
    except Exception:
        pass
    return None

