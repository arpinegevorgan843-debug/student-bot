@dp.message(F.text.in_({MENU["hw_list"]["ru"], MENU["hw_list"]["en"]}))
async def hw_list(message: types.Message):
    lang = await get_lang(message.from_user.id)
    async with aiosqlite.connect(DB) as db:
        async with db.execute("""SELECT id, subject, task, photo_id, done, due_date
            FROM homework WHERE user_id=?""", (message.from_user.id,)) as cur:
            rows = await cur.fetchall()

    if not rows:
        await message.answer(T(lang, "hw_none"))
        return

    with_date = [r for r in rows if r[5]]
    without_date = [r for r in rows if not r[5]]
    with_date.sort(key=lambda r: (r[5], r[0]))
    rows = with_date + without_date

    text = T(lang, "hw_head") + "\n\n"
    buttons = []
    last_due = None

    for hw_id, subj, task, photo, done, due in rows:
        if due != last_due:
            if due:
                try:
                    dd = datetime.fromisoformat(due)
                    text += f"📅 <b>{DAY_NAMES[lang][dd.weekday()]}, {dd.day} {MONTHS[lang][dd.month - 1]}</b>\n\n"
                except Exception:
                    pass
            elif with_date or last_due is not None:
                text += "📅 <b>Без даты</b>\n\n" if lang == "ru" else "📅 <b>No date</b>\n\n"
            last_due = due

        emoji = subject_emoji(subj)
        mark = "🔳" if done else "🔲"
        if done:
            text += f"  {mark} {emoji} <b>{esc(subj)}</b>\n     <s>{esc(task)}</s>\n\n"
            buttons.append((T(lang, "btn_undo", s=subj[:15]), f"hwdone_{hw_id}"))
        else:
            text += f"  {mark} {emoji} <b>{esc(subj)}</b>\n     {esc(task)}\n\n"
            buttons.append((T(lang, "btn_done", s=subj[:15]), f"hwdone_{hw_id}"))
        if photo:
            buttons.append((T(lang, "btn_photo"), f"hwphoto_{hw_id}"))

    await safe_send(message, text + phrase(lang, "hw"), reply_markup=buttons_to_kb(buttons, lang))

