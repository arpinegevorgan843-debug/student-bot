@dp.message()
async def chat_chat(message: types.Message):
    lang = await get_lang(message.from_user.id)
    t = message.text or ""
    if t.startswith("/"):
        await message.answer(T(lang, "unknown_cmd"))
        return
    if "спасибо" in t.lower() or "спс" in t.lower() or "thank" in t.lower() or "thx" in t.lower():
        addr = random.choice(PHR["thanks_addr"][lang])
        await message.answer(T(lang, "thanks", addr=addr))
        try:
            await message.answer_photo(photo=random.choice(CUTE_IMAGES), caption=T(lang, "photo_cap"))
        except Exception:
            pass
        return
    await message.answer(phrase(lang, "fallback"))

# ---------- СЕРВЕР + НЕ ДАЁМ RENDER ЗАСНУТЬ ----------
RENDER_URL = os.getenv("RENDER_EXTERNAL_URL")

async def keep_alive():
    if not RENDER_URL:
        return
    async with aiohttp.ClientSession() as session:
        while True:
            try:
                async with session.get(RENDER_URL) as r:
                    pass
            except Exception:
                pass
            await asyncio.sleep(10 * 60)

async def web_server():
    app = web.Application()
    app.router.add_get("/", lambda r: web.Response(text="Bot is running 💕"))
    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", 8080)
    await site.start()

async def main():
    await init_db()
    asyncio.create_task(web_server())
    asyncio.create_task(keep_alive())
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
