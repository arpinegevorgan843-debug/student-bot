async def show_note_week(callback: types.CallbackQuery, action: str, subject: str, idx: int, offset: int):
    user_id = callback.from_user.id
    lang = await get_lang(user_id)
    monday = datetime.now() - timedelta(days=datetime.now().weekday()) + timedelta(weeks=offset)
    text = f"🌼 <b>{esc(subject)}</b> — {wd(get_week_type(monday), lang)} неделя\n"
    text += ("Выбери пару кнопкой ниже — там будет заметочка ✨" if lang == "ru"
             else "Pick a lesson below — the note goes there ✨")
    buttons = []
    async with aiosqlite.connect(DB) as db:
        for i in range(7):
            d = monday + timedelta(days=i)
            day_ru = DAY_NAMES["ru"][i]
            async with db.execute("""SELECT id, time, subject, lesson_type, note FROM schedule
                WHERE user_id=? AND day=? AND subject=? AND (week_type=? OR week_type='Каждую') AND (hidden IS NULL OR hidden=0)""",
                (user_id, day_ru, subject, get_week_type(d))) as cur:
                lessons = await cur.fetchall()
            for lid, t, s, lt, note in sorted(lessons, key=lambda l: time_sort_key(l[1])):
                ds = f"{d.day}.{d.month:02d}"
                if note:
                    short = note[:25] + ("…" if len(note) > 25 else "")
                    label = f"💌 {DAYS_SHORT[lang][i]} {ds} · {t} — {short}"
                else:
                    label = f"➕ {DAYS_SHORT[lang][i]} {ds} · {t}"
                buttons.append((label, f"nslot_{action}_{lid}"))
    if not buttons:
        text += ("\n\nНа этой неделе у этой дисциплины пар нет 🙈" if lang == "ru"
                 else "\n\nNo lessons of this subject this week 🙈")
    b = InlineKeyboardBuilder()
    for label, data in buttons:
        b.button(text=label, callback_data=data)
    b.button(text="⬅️ Пред. неделя" if lang == "ru" else "⬅️ Prev", callback_data=f"nweek_{action}_{idx}_{offset-1}")
    b.button(text="След. неделя ➡️" if lang == "ru" else "Next ➡️", callback_data=f"nweek_{action}_{idx}_{offset+1}")
    b.button(text="◀️ Другая дисциплина" if lang == "ru" else "◀️ Another subject", callback_data=f"nback_{action}")
    b.button(text=T(lang, "btn_back"), callback_data="nmenu_back")
    b.adjust(2, 1, 1)
    try:
        await callback.message.edit_text(text, reply_markup=b.as_markup(), parse_mode="HTML")
    except Exception:
        await callback.message.answer(text, reply_markup=b.as_markup(), parse_mode="HTML")
    await callback.answer()

@dp.callback_query(F.data.startswith("nslot_"))
async def note_slot_pick(callback: types.CallbackQuery, state: FSMContext):
    lang = await get_lang(callback.from_user.id)
    _, action, lid = callback.data.split("_")
    async with aiosqlite.connect(DB) as db:
        async with db.execute("SELECT subject, note FROM schedule WHERE id=?", (lid,)) as cur:
            row = await cur.fetchone()
    if not row:
        await callback.answer(T(lang, "edit_gone"))
        return
    subj, note = row

    if action == "add" and note:
        await callback.answer(
            "Тут уже есть заметочка 💕 Хочешь её поменять — выбери «✏️ Изменить заметочку»" if lang == "ru"
            else "A note already exists here 💕 Use «✏️ Edit a note»")
        return
    if action in ("edit", "del") and not note:
        await callback.answer("Тут пока нет заметочки 🙈" if lang == "ru" else "No note here yet 🙈")
        return
    if action == "del":
        async with aiosqlite.connect(DB) as db:
            await db.execute("UPDATE schedule SET note=NULL WHERE id=?", (lid,))
            await db.commit()
        await callback.answer("🗑 Заметочка удалена" if lang == "ru" else "🗑 Note deleted")
        await show_note_week(callback, action, subj, 0, 0)
        return

    await state.update_data(note_id=lid, note_mode=action)
    if action == "edit":
        await callback.message.answer(
            f"Текущая заметочка:\n«{esc(note)}»\n\nНапиши новую:\n(«Отмена» — передумать)" if lang == "ru"
            else f"Current note:\n«{esc(note)}»\n\nType the new one:\n(«Cancel» to abort)")
    else:
        await callback.message.answer(
            "Отлично, добавляем заметочку! Напиши её текст:\n(«Отмена» — передумать)" if lang == "ru"
            else "Adding a note! Type its text:\n(«Cancel» to abort)")
    await state.set_state(BotStates.waiting_for_note)
    await callback.answer()

