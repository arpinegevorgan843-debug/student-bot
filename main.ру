async def build_day_view(user_id, target_date, lang):
    day_name = DAY_NAMES["ru"][target_date.weekday()]
    week_type = get_week_type(target_date)
    async with aiosqlite.connect(DB) as db:
        async with db.execute("""SELECT id, time, subject, lesson_type, room, teacher, note FROM schedule
            WHERE user_id=? AND day=? AND (week_type=? OR week_type='Каждую')""",
            (user_id, day_name, week_type)) as cur:
            lessons = await cur.fetchall()
        async with db.execute("SELECT id, subject, task, photo_id, done FROM homework WHERE user_id=?", (user_id,)) as cur:
            all_hws = await cur.fetchall()

    lessons = sorted(lessons, key=lambda l: time_sort_key(l[1]))

    if not lessons:
        return T(lang, "day_head", day=DAY_NAMES[lang][target_date.weekday()], week=wd(week_type, lang)) + "\n\n" + T(lang, "no_lessons"), []

    text = T(lang, "day_head", day=DAY_NAMES[lang][target_date.weekday()], week=wd(week_type, lang)) + "\n\n"
    buttons = []
    for num, (lesson_id, time_, subj, l_type, room, teacher, note) in enumerate(lessons, 1):
        emoji = subject_emoji(subj)
        text += f"<b>{num}.</b> {esc(time_)} — {emoji} {esc(subj)}\n"
        text += f"   {esc(l_type)}"
        if room:
            text += f" | 📍 {esc(room)}"
        if teacher:
            text += f" | 🦋 {esc(teacher)}"
        text += "\n"

        subj_l = subj.lower()
        for hw_id, hw_subj, hw_task, hw_photo, hw_done in all_hws:
            ws = hw_subj.lower()
            if ws in subj_l or any(w.lower() in subj_l for w in ws.split()):
                task = esc(hw_task)
                if hw_done:
                    text += "   " + T(lang, "hw_done", task=task) + "\n"
                else:
                    text += "   " + T(lang, "hw", task=task) + "\n"
                    if hw_photo:
                        text += "   " + T(lang, "photo_lbl") + "\n"
                    buttons.append((T(lang, "btn_done", s=hw_subj[:15]), f"hwdone_{hw_id}"))
                    if hw_photo:
                        buttons.append((T(lang, "btn_photo", s=hw_subj[:12]), f"hwphoto_{hw_id}"))
                break

        if note:
            text += "   " + T(lang, "note_lbl", note=esc(note)) + "\n"
        buttons.append((T(lang, "btn_note", s=subj[:15]), f"addnote_{lesson_id}"))
        text += "\n"

    return text, buttons

def buttons_to_kb(buttons, lang):
    b = InlineKeyboardBuilder()
    for label, data in buttons:
        b.button(text=label, callback_data=data)
    b.button(text=T(lang, "btn_back"), callback_data="back_to_main")
    b.adjust(1)
    return b.as_markup()

