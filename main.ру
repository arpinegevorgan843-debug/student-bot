async def save_hw_final(message: types.Message, state: FSMContext):
    data = await state.get_data()
    hw_text = data["hw_text"]
    photos = data.get("photos", [])
    words = [w for w in hw_text.split() if len(w) > 3]

    nearest = None
    today = datetime.now()
    async with aiosqlite.connect(DB) as db:
        for i in range(8):
            d = today + timedelta(days=i)
            day_name = DAYS[d.weekday()]
            for w in words:
                async with db.execute("""SELECT subject, lesson_type FROM schedule
                    WHERE user_id=? AND day=? AND subject LIKE ?""",
                    (message.from_user.id, day_name, f"%{w}%")) as cur:
                    rows = await cur.fetchall()
                for r in rows:
                    if "семинар" in r[1].lower():
                        nearest = r[0]
                        break
                if nearest: break
            if nearest: break

    if not nearest:
        await message.answer("❌ Ближайший семинар по этому тексту не найден, домашечка не сохранилась.")
    else:
        async with aiosqlite.connect(DB) as db:
            await db.execute("INSERT INTO homework (user_id, subject, task, photo_id) VALUES (?, ?, ?, ?)",
                (message.from_user.id, nearest, hw_text, ",".join(photos) if photos else None))
            await db.commit()
        await message.answer(f"✅ Домашечка привязана к <b>{esc(nearest)}</b>! ✨", parse_mode="HTML")
    await state.clear()

