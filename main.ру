async def handle_menu(message: types.Message, state: FSMContext):
    user_id = message.from_user.id
    text = message.text
    lang = await get_user_lang(user_id)
    
    if text in MENU_BY_TEXT:
        action = MENU_BY_TEXT[text]
        
        if action == "today":
            today = DAY_NAMES[lang][datetime.now().weekday()]
            date_str = datetime.now().strftime("%d.%m")
            lessons = await get_lessons_for_day(user_id, today)
            
