async def cmd_week(message: types.Message, state: FSMContext):
    await state.clear()
    week_type = get_week_type_today()
    
    async with aiosqlite.connect(DB) as db:
        cur = await db.execute(
            "SELECT day, time_range, subject, lesson_type, room, teacher FROM schedule WHERE week_type=?",
            (week_type,)
        )
        rows = await cur.fetchall()
    
    if not rows:
        await message.answer(T("ru", "week_empty"))
        return
    
    # Группируем по дням
    from collections import defaultdict
    days_data = defaultdict(list)
    for row in rows:
        day, *rest = row
        days_data[day].append(rest)
    
    text = T("ru", "week_head", week=wd(week_type, "ru"))
    text += "\n\n"
    
    for day_name in DAY_NAMES["ru"]:
        if day_name in days_data:
            text += f"🗓 <b>{day_name}</b>\n"
            for i, (time_, subj, ltype, room, teacher) in enumerate(days_data[day_name], 1):
                text += lesson_block(i, time_, subj, ltype, room, teacher) + "\n"
            text += "\n"
    
    await safe_send(message, text)

