def subject_emoji(subj: str) -> str:
    s = (subj or "").lower()
    if any(x in s for x in ["конституц", "гос", "право", "law", "state"]):
        return "🏛️"
    if any(x in s for x in ["уголов", "кримин", "судоустройств", "criminal", "court"]):
        return "⚖️"
    if any(x in s for x in ["гражд", "хозяйств", "предпринимат", "civil"]):
        return "📜"
    if any(x in s for x in ["история", "history", "древн"]):
        return "📂"
    if any(x in s for x in ["английск", "иностр", "eng", "foreign", "language", "язык"]):
        return "🔤"
    if any(x in s for x in ["физическ", "спорт", "phys", "sport"]):
        return "💪"
    if any(x in s for x in ["философ", "финанс", "этик", "philosoph", "financ", "ethic"]):
        return "🧠"
    return "📚"

def get_week_type(date_obj):
    return "Четная" if date_obj.isocalendar()[1] % 2 == 0 else "Нечетная"

def normalize_week(text):
    t = (text or "").strip().lower()
    if t.startswith("чет") or t.startswith("even"):
        return "Четная"
    if t.startswith("нечет") or t.startswith("нечёт") or t.startswith("odd"):
        return "Нечетная"
    if t.startswith("каж") or t.startswith("every") or t.startswith("all"):
        return "Каждую"
    return None

def esc(s):
    return html.escape(str(s or ""))

def time_sort_key(time_str):
    m = re.search(r"(\d{1,2}):(\d{2})", str(time_str or ""))
    if not m:
        return (23, 59)
    return (int(m.group(1)), int(m.group(2)))

