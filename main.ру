async def make_day_card(day_title, week_label, lessons, lang, user_id=None):
    W, pad = 1080, 56
    card_h, gap = 240, 30
    bg = await _fetch_cute_photo(user_id)
    photo_h = 520 if lessons else 760
    top = photo_h if bg is not None else 250
    H = top + 460 if not lessons else top + 40 + len(lessons) * (card_h + gap) + 150

    img = Image.new("RGB", (W, H), (255, 238, 246))
    d = ImageDraw.Draw(img)
    img.paste(_pink_gradient(W, H), (0, 0))

    rnd = random.Random(11)
    for _ in range(70):
        x, yy = rnd.randint(0, W), rnd.randint(0, H)
        s = rnd.choice([3, 4, 5])
        d.line([(x - s, yy), (x + s, yy)], fill=(255, 255, 255))
        d.line([(x, yy - s), (x, yy + s)], fill=(255, 255, 255))
    for _ in range(9):
        x, yy = rnd.randint(40, W - 40), rnd.randint(top, max(top + 1, H - 40))
        _heart(d, x, yy, rnd.choice([7, 9, 11]), (255, 170, 200))

    if bg is not None:
        ratio = max(W / bg.width, photo_h / bg.height)
        nw, nh = int(bg.width * ratio) + 1, int(bg.height * ratio) + 1
        bg = bg.resize((nw, nh))
        bx, by = (nw - W) // 2, (nh - photo_h) // 2
        img.paste(bg.crop((bx, by, bx + W, by + photo_h)), (0, 0))
        img = img.convert("RGBA")
        img.alpha_composite(Image.new("RGBA", (W, photo_h), (255, 214, 233, 150)), (0, 0))
        img = img.convert("RGB")
        d = ImageDraw.Draw(img)
        d.line([(0, photo_h - 3), (W, photo_h - 3)], fill=(255, 190, 215), width=5)

    f_day, f_week = _font(72, bold=True), _font(36, bold=True)
    ty = 48
    for line in _wrap(d, day_title, f_day, W - 2 * pad):
        d.text((pad, ty), line, font=f_day,
               fill=(255, 255, 255) if bg is not None else PINK_DARK,
               stroke_width=3 if bg is not None else 0, stroke_fill=PINK_DARK)
        ty += 84
    d.text((pad, ty + 4), week_label, font=f_week,
           fill=(255, 255, 255) if bg is not None else PINK_DARK)

    f_num, f_type = _font(50, bold=True), _font(26, bold=True)
    f_time, f_subj = _font(34, bold=True), _font(38, bold=True)
    f_meta = _font(28)

    if not lessons:
        empty_txt = ("Пар нет. День красоты и отдыха!" if lang == "ru"
                     else "No lessons. A day for beauty and rest!")
        d.rounded_rectangle([pad, top + 60, W - pad, top + 300], radius=40,
                            fill=CARD_FILL, outline=CARD_LINE, width=3)
        ey = top + 120
        for line in _wrap(d, empty_txt, f_subj, W - 2 * pad - 60):
            d.text((pad + 30, ey), line, font=f_subj, fill=PINK_DARK)
            ey += 48
    else:
        y = top + 40
        for num, (time_, subj, ltype, room, teacher) in enumerate(lessons, 1):
            cy = y + card_h // 2
            d.rounded_rectangle([pad, y, W - pad, y + card_h], radius=34,
                                fill=CARD_FILL, outline=CARD_LINE, width=3)
            bx_, by_ = pad + 66, cy
            d.ellipse([bx_ - 40, by_ - 40, bx_ + 40, by_ + 40],
                      fill=(255, 224, 238), outline=PINK_ACCENT, width=3)
            _center_text(d, bx_, by_, str(num), f_num, PINK_DARK)
            tx = pad + 140
            max_w = W - pad - tx - 24
            d.text((tx, y + 20), (ltype or "").upper(), font=f_type, fill=PINK_ACCENT)
            d.text((tx, y + 52), time_ or "", font=f_time, fill=PINK_DARK)
            sy = y + 96
            for line in _wrap(d, subj, f_subj, max_w)[:2]:
                d.text((tx, sy), line, font=f_subj, fill=(105, 45, 75))
                sy += 46
            meta = " · ".join(x for x in [teacher, ("ауд. " + room if room else "")] if x)
            if meta:
                d.text((tx, y + card_h - 44), meta, font=f_meta, fill=PINK_MUTED)
            y += card_h + gap

    footer = "с любовью, твоя помощница" if lang == "ru" else "with love, your little helper"
    d.text((pad, H - 64), footer, font=_font(30), fill=PINK_DARK)

    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return BufferedInputFile(buf.getvalue(), filename="schedule.png")

