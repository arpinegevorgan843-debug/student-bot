async def hw_add_task(message: types.Message, state: FSMContext):
    text = message.text or ""
    if text.lower() in ["отмена", "cancel"]:
        await state.clear()
        await message.answer(T("ru", "cancel"))
        return
    
    if ":" not in text:
        await message.answer(T("ru", "hw_bad_subject"))
        return
    
    subject, task = text.split(":", 1)
    subject = subject.strip()
    task = task.strip()
    
    # Сохраняем в БД (без привязки к паре пока, можно доработать)
    user_id = message.from_user.id
    async with aiosqlite.connect(DB) as db:
        await db.execute(
            "INSERT INTO homework (user_id, subject, task) VALUES (?, ?, ?)",
            (user_id, subject, task)
        )
        await db.commit()
    
    await state.set_state(HWState.waiting_for_photos)
    await message.answer(T("ru", "hw_saved", s=subject))

async def hw_handle_photos(message: types.Message, state: FSMContext):
    user_id = message.from_user.id
    
    # Получаем последнюю домашку этого пользователя
    async with aiosqlite.connect(DB) as db:
        cur = await db.execute(
            "SELECT id FROM homework WHERE user_id=? ORDER BY id DESC LIMIT 1",
            (user_id,)
        )
        row = await cur.fetchone()
        if not row:
            await message.answer("Сначала добавь задание!")
            return
        hw_id = row
        
        # Скачиваем и кэшируем фото
        photos_list = 
        if message.photo:
            # Берём фото максимального качества
            photo = message.photo[-1]
            file = await bot.get_file(photo.file_id)
            file_path = await bot.download_file(file.file_path)
            
            # Сжимаем и сохраняем в кэш
            # Для простоты сохраняем как есть, но можно добавить сжатие
            cached_path = os.path.join(PHOTO_CACHE_DIR, f"hw_{hw_id}_{photo.file_id}.jpg")
            with open(cached_path, "wb") as f:
                f.write(file_path.read())
            
            photos_list.append(cached_path)
        
        if photos_list:
            photos_str = "|".join(photos_list)
            await db.execute(
                "UPDATE homework SET photos=? WHERE id=?",
                (photos_str, hw_id)
            )
            await db.commit()
            
            count = len(photos_list)
            await message.answer(T("ru", "hw_photos", n=count))
        else:
            await message.answer("Фото не найдено.")
    
    await state.clear()
    await message.answer(T("ru", "hw_finish"))

async def hw_action(callback: types.CallbackQuery, state: FSMContext):
    data = callback.data
    if not data.startswith("hw_"):
        return
    
    parts = data.split("_")
    if len(parts) < 3:
        return
    
    hw_id = int(parts)
    action = parts
    user_id = callback.from_user.id
    
    async with aiosqlite.connect(DB) as db:
        if action == "done":
            await db.execute("UPDATE homework SET done=1 WHERE id=? AND user_id=?", (hw_id, user_id))
            await db.commit()
            await callback.answer("Готово! Ты молодец! ✨")
        elif action == "undo":
            await db.execute("UPDATE homework SET done=0 WHERE id=? AND user_id=?", (hw_id, user_id))
            await db.commit()
            await callback.answer("Вернули в список. Успеешь позже! 🌸")
        elif action == "photo":
            # Логика загрузки фото уже в отдельном хендлере на сообщения
            await callback.answer("Пришли фото сюда, я сохраню! 📸")
        elif action == "note":
            await callback.answer("Скоро добавлю заметки! Пока просто помни про это! 💕")
    
    await hw_menu(callback.message, state)

async def handle_photo_for_hw(message: types.Message, state: FSMContext):
    # Если мы в состоянии ожидания фото для домашки
    if await state.get_state() == HWState.waiting_for_photos:
        await hw_handle_photos(message, state)
        return
    
    # Если фото пришло просто так — игнорируем или обрабатываем отдельно
    pass

