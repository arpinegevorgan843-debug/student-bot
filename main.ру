async def build_day_view(user_id, target_date):
    day_name = DAYS[target_date.weekday()]
    week_type = get_week_type(target_date)
    async with aiosqlite.connect(DB) as db:
        async with db.execute("""SELECT id, time, subject, lesson_type, room, teacher, note FROM schedule
            WHERE user_id=? AND day=? AND (week_type=? OR week_type='Каждую') ORDER BY time""",
            (user_id, day_name, week_type)) as cur:
            lessons = await cur.fetchall()
        async with db.execute("SELECT id, subject, task, photo_id, done FROM homework WHERE user_id=?", (user_id,)) as cur:
            all_hws = await cur.fetchall()

    if not lessons:
        return f"📅 {day_name} ({week_type} неделя)\n\nПар нет… Ой, как круто 🎉✨ Ура, можно отдыхать 💃🌸", []

    text = f"📅 <b>{day_name} ({week_type} неделя)</b>\n\n"
    buttons = []
    for lesson_id, time_, subj, l_type, room, teacher, note in lessons:
        emoji = subject_emoji(subj)
        text += f"🎀 {esc(time_)} | {emoji} {esc(subj)}\n"
        text += f"✨ {esc(l_type)}"
        if room: text += f" | 📍 {esc(room)}"
        if teacher: text += f" | 🦋 {esc(teacher)}"
        text += "\n"

        subj_l = subj.lower()
        for hw_id, hw_subj, hw_task, hw_photo, hw_done in all_hws:
            ws = hw_subj.lower()
            if ws in subj_l or any(w.lower() in subj_l for w in ws.split()):
                task = esc(hw_task)
                if hw_done:
                    text += f"   💖 <s>Домашечка: {task}</s>\n"
                else:
                    text += f"   💖 Домашечка: {task}\n"
                    if hw_photo: text += f"   🖼 [Фото]\n"
                    buttons.append((f"✅ Выполнено: {hw_subj[:15]}", f"hwdone_{hw_id}"))
                    if hw_photo: buttons.append((f"🖼 Фото ({hw_subj[:12]})", f"hwphoto_{hw_id}"))

        if note: text += f"   💌 Заметочка: {esc(note)}\n"
        buttons.append((f"💌 Заметка к {subj[:15]}", f"addnote_{lesson_id}"))
        text += "\n"
    return text, buttons

def buttons_to_kb(buttons):
    b = InlineKeyboardBuilder()
    for label, data in buttons:
        b.button(text=label, callback_data=data)
    b.button(text="◀️ Назад в меню", callback_data="back_to_main")
    b.adjust(1)
    return b.as_markup()

