@dp.message(BotStates.waiting_for_edit_value)
async def edit_value_save(message: types.Message, state: FSMContext):
    if await check_menu(message, state):
        return
    lang = await get_lang(message.from_user.id)
    data = await state.get_data()
    field = data.get("edit_field")
    lesson_id = data.get("edit_id")
    new_val = message.text

    if field == "week_type":
        wt = normalize_week(new_val)
        if not wt:
            await message.answer(T(lang, "week_bad"))
            return
        new_val = wt
    elif field in ("room", "teacher"):
        new_val = "" if new_val == "-" else new_val

    async with aiosqlite.connect(DB) as db:
        await db.execute(f"UPDATE schedule SET {field}=? WHERE id=?", (new_val, lesson_id))
        await db.commit()
    await state.clear()

    fake_callback = types.CallbackQuery(id="0", from_user=message.from_user, chat_instance="0", message=message, data=f"editpair_{lesson_id}")
    await show_pair_edit_menu(fake_callback, lesson_id)
    await message.answer(T(lang, "edit_done"))

