async def save_hw(user_id, hw_text, photos, subject_override=None):
    now = datetime.now()
    target_subject = subject_override
    target_date = None

    async with aiosqlite.connect(DB) as db:
        if not target_subject:
            words = [w.strip(string.punctuation).lower()[:5] for w in hw_text.split() if len(w) > 4]

        for i in range(14):
            d = now + timedelta(days=i)
            day_name = DAY_NAMES["ru"][d.weekday()]
            async with db.execute("""SELECT time, subject FROM schedule
                WHERE user_id=? AND day=? AND (hidden IS NULL OR hidden=0)""",
                (user_id, day_name)) as cur:
                rows = await cur.fetchall()
            rows = sorted(rows, key=lambda r: time_sort_key(r[0]))

            for time_, subj in rows:
                m = re.match(r"(\d{1,2}):(\d{2})", time_ or "")
                # урок сегодняшний и уже начался/прошёл — пропускаем
                if i == 0 and m and (int(m.group(1)), int(m.group(2))) <= (now.hour, now.minute):
                    continue
                if target_subject:
                    if subj.lower() == target_subject.lower():
                        target_date = d.date()
                        break
                else:
                    if any(w in subj.lower() for w in words):
                        target_date = d.date()
                        target_subject = subj
                        break
            if target_date:
                break

        if not target_subject:
            return None

        cur = await db.execute(
            """INSERT INTO homework (user_id, subject, task, photo_id, due_date)
            VALUES (?, ?, ?, ?, ?)""",
            (user_id, target_subject, hw_text, ",".join(photos) if photos else None, target_date.isoformat()))
        await db.commit()
        return cur.lastrowid

@dp.message(BotStates.waiting_for_hw_text)
async def add_hw_text(message: types.Message, state: FSMContext):
    if await check_menu(message, state):
        return
    lang = await get_lang(message.from_user.id)
    text = message.text.strip()

    subject_override = None
    task_text = text

    if ":" in text:
        parts = text.split(":", 1)
        candidate = parts[0].strip().lower()
        for d, t, s, r, te in SEED_DATA:
            if candidate and candidate in s.lower():
                subject_override = s
                break
        if subject_override:
            task_text = parts[1].strip()
        else:
            await message.answer(T(lang, "hw_bad_subject"))
            return

    hw_id = await save_hw(message.from_user.id, task_text, [], subject_override)
    if hw_id is None:
        await state.clear()
        await message.answer(T(lang, "hw_not_found"))
        return

    await state.update_data(hw_id=hw_id, photos=[])
    PHOTO_COUNTS[message.from_user.id] = 0
    await message.answer(T(lang, "hw_saved", s=subject_override or "предмет"))
    await state.set_state(BotStates.waiting_for_hw_photo)

async def photo_reply_later(user_id: int, chat_id: int, lang: str):
    try:
        await asyncio.sleep(1.5)
        n = PHOTO_COUNTS.get(user_id, 0)
        await bot.send_message(chat_id, T(lang, "hw_photos", n=n))
    except asyncio.CancelledError:
        pass
    except Exception:
        pass
    finally:
        PHOTO_REPLY_TASKS.pop(user_id, None)

